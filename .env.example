# Local development defaults
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./payload-cms-next-tailwind-shadcn-starter-kit.db
PAYLOAD_SECRET=YOUR_SECRET_HERE
EMAIL_PROVIDER=none
MEDIA_PROVIDER=localDisk

# Default local-disk media storage is fine for local development.
# Use MEDIA_PROVIDER=s3 with the S3 variables below for IDrive e2 or another S3-compatible host.

# Resend
# Set EMAIL_PROVIDER=resend when email delivery is required.
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=hello@yourdomain.com
RESEND_FROM_NAME=Your Website

# Optional: force all outgoing emails to a single inbox while testing
# RESEND_OVERRIDE_TO_EMAIL=you@example.com

# Vercel Postgres deployment
# DATABASE_PROVIDER=postgres
# POSTGRES_URL=postgres://user:password@host:5432/database

# S3-compatible media storage (example: IDrive e2)
# MEDIA_PROVIDER=s3
# S3_BUCKET=your-test-bucket
# S3_ENDPOINT=https://s3.ap-southeast-1.idrivee2.com
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_ACL=public-read
# S3_FORCE_PATH_STYLE=true
# Set to true on Vercel if you want direct client uploads for larger files.
# This requires PUT CORS on the bucket for your site origin.
# S3_CLIENT_UPLOADS=false
