# Database configuration
MONGODB_URI=mongodb://127.0.0.1:27017/payload-cms-starter-kit?replicaSet=rs0&directConnection=true

# E2E accepts only an explicit loopback database ending in _test or -test.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/payload-cms-starter-kit_test?replicaSet=rs0&directConnection=true

# Payload secret for authentication and encryption.
# Replace this placeholder. Production requires at least 32 unique characters.
PAYLOAD_SECRET=YOUR_PAYLOAD_CMS_SECRET_HERE

# Canonical application origin. Production requires HTTPS; local development may use loopback HTTP.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Keep disabled except during the one-time first Admin creation sequence.
ALLOW_FIRST_ADMIN_CREATION=false
# Production bootstrap also requires the one permitted account email.
# FIRST_ADMIN_EMAIL=first.admin@example.com

# Optional Shadcn Blocks tooling key; not used by the CMS runtime
SHADCNBLOCKS_API_KEY=SHADCNBLOCKS_API_KEY_HERE

# Email configuration
# none disables self-service password-reset requests; clients ask their creating Admin.
# Client email recovery requires working Resend delivery and no recipient override.
EMAIL_PROVIDER=none
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=hello@yourdomain.com
RESEND_FROM_NAME=Your Website
# A recipient override disables client self-service password recovery; remove before handoff.
# RESEND_OVERRIDE_TO_EMAIL=qa-inbox@example.com
# Production recipient overrides require this explicit acknowledgement.
ALLOW_PRODUCTION_EMAIL_OVERRIDE=false

# Local development uses the repository's local media directory.
MEDIA_PROVIDER=localDisk

# S3-compatible public marketing-media storage for hosted uploads (Cloudflare R2 example).
# Private submissions require a separate collection and private bucket path.
# Set MEDIA_PROVIDER=s3 and configure every required S3 value in hosted environments.
# S3_BUCKET=snmih-media
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_r2_access_key
# S3_SECRET_ACCESS_KEY=your_r2_secret_key
# S3_PUBLIC_URL=https://assets.snmih.tanish.im
# R2 does not support S3 object ACLs. Use none to omit the ACL header.
# S3_ACL=none
# S3_FORCE_PATH_STYLE=true
# Media uploads always pass through the application server for pre-persistence validation.

# Optional: secure token for the on-demand media reconciliation route.
# Use this with POST /api/operations/media/reconcile-storage
# MEDIA_RECONCILE_TOKEN=change-me

# Optional database backups (separate private bucket; never the media bucket).
# See docs/operations/database-backups.md. GitHub scheduling requires the
# repository variable ENABLE_PROD_DB_BACKUPS=true; it is disabled by default.
# PROD_MONGODB_URI=mongodb+srv://backup-user:password@cluster.example.com
# PROD_DB_BACKUP_DATABASE=your_database
# PROD_DB_BACKUP_BUCKET=your-private-database-backups
# PROD_DB_BACKUP_PREFIX=prod-db-backup/
# PROD_DB_BACKUP_RETENTION_COUNT=30
# R2_BACKUP_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BACKUP_ACCESS_KEY_ID=your_backup_access_key
# R2_BACKUP_SECRET_ACCESS_KEY=your_backup_secret_key

# Private form attachments. Separate from public Media, never a public bucket/CDN.
# Development defaults to localDisk in .private/form-attachments; production defaults
# to disabled until configured. Production uploads require s3 and all values below.
FORM_ATTACHMENTS_PROVIDER=localDisk
# FORM_ATTACHMENTS_PROVIDER=s3
# FORM_ATTACHMENTS_S3_BUCKET=your-private-form-attachments
# FORM_ATTACHMENTS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# FORM_ATTACHMENTS_S3_REGION=auto
# FORM_ATTACHMENTS_S3_ACCESS_KEY_ID=private_bucket_access_key
# FORM_ATTACHMENTS_S3_SECRET_ACCESS_KEY=private_bucket_secret_key
# Optional; defaults true. No public URL or object ACL is ever applied.
# FORM_ATTACHMENTS_S3_FORCE_PATH_STYLE=true
# Keep bucket public access disabled and credentials limited to this bucket.
# Schedule `pnpm cleanup:form-attachments` hourly to remove abandoned/deleted files.
