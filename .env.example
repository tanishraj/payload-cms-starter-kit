# Database configuration
DATABASE_URL=mongodb://127.0.0.1:27017/payload-cms-starter-kit

# Payload secret for authentication and encryption
PAYLOAD_SECRET=YOUR_PAYLOAD_CMS_SECRET_HERE

# Shadcn Blocks API key for accessing Shadcn Blocks services
SHADCNBLOCKS_API_KEY=SHADCNBLOCKS_API_KEY_HERE

# Email configuration
EMAIL_PROVIDER=none
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=hello@yourdomain.com
RESEND_FROM_NAME=Your Website
RESEND_OVERRIDE_TO_EMAIL=you@example.com

# S3-compatible media storage (example: IDrive e2)
MEDIA_PROVIDER=s3
S3_BUCKET=your-test-bucket
S3_ENDPOINT=https://s3.ap-northeast-1.idrivee2.com
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_ACL=public-read
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Set to true on Vercel if you want direct client uploads for larger files.
# This requires PUT CORS on the bucket for your site origin.
S3_CLIENT_UPLOADS=false

# Optional: secure token for the on-demand media reconciliation route.
# Use this with POST /api/operations/media/reconcile-storage
# MEDIA_RECONCILE_TOKEN=change-me
