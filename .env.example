# Database configuration
MONGODB_URI=mongodb://127.0.0.1:27017/payload-cms-starter-kit?replicaSet=rs0&directConnection=true

# E2E accepts only an explicit loopback database ending in _test or -test.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/payload-cms-starter-kit_test?replicaSet=rs0&directConnection=true

# Payload secret for authentication and encryption.
# Replace this placeholder. Production requires at least 32 unique characters.
PAYLOAD_SECRET=YOUR_PAYLOAD_CMS_SECRET_HERE

# Canonical application origin. Production requires HTTPS; local development may use loopback HTTP.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Keep disabled except during the one-time first Admin creation sequence.
ALLOW_FIRST_ADMIN_CREATION=false
# Production bootstrap also requires the one permitted account email.
# FIRST_ADMIN_EMAIL=first.admin@example.com

# Optional Shadcn Blocks tooling key; not used by the CMS runtime
SHADCNBLOCKS_API_KEY=SHADCNBLOCKS_API_KEY_HERE

# Email configuration
EMAIL_PROVIDER=none
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=hello@yourdomain.com
RESEND_FROM_NAME=Your Website
# RESEND_OVERRIDE_TO_EMAIL=qa-inbox@example.com
# Production recipient overrides require this explicit acknowledgement.
ALLOW_PRODUCTION_EMAIL_OVERRIDE=false

# Local development uses the repository's local media directory.
MEDIA_PROVIDER=localDisk

# S3-compatible public marketing-media storage for hosted uploads (Cloudflare R2 example).
# Private submissions require a separate collection and private bucket path.
# Set MEDIA_PROVIDER=s3 and configure every required S3 value in hosted environments.
# S3_BUCKET=snmih-media
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_r2_access_key
# S3_SECRET_ACCESS_KEY=your_r2_secret_key
# S3_PUBLIC_URL=https://assets.snmih.tanish.im
# R2 does not support S3 object ACLs. Use none to omit the ACL header.
# S3_ACL=none
# S3_FORCE_PATH_STYLE=true
# Media uploads always pass through the application server for pre-persistence validation.

# Optional: secure token for the on-demand media reconciliation route.
# Use this with POST /api/operations/media/reconcile-storage
# MEDIA_RECONCILE_TOKEN=change-me
